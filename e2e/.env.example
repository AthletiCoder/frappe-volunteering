# Copy to e2e/.env (gitignored) and adjust.
BASE_URL=http://sevamrita.local:8000

# Parallel / multi-site runs (see docs/e2e-parallel.md)
# E2E_AUTH_DIR=e2e/.auth-hr
# BASE_URL_ACCOUNTS=http://127.0.0.1:8001
# PW_WORKERS=1
E2E_ADMIN_USER=Administrator
E2E_ADMIN_PASSWORD=password
FRAPPE_USER=Administrator
FRAPPE_PASSWORD=password

# Shared password for seeded e2e.*@sevamrita.local users
E2E_PASSWORD=E2eTestPass!26

# Optional per-persona overrides:
# E2E_EMPLOYEE_USER=e2e.employee@sevamrita.local
# E2E_MANAGER_USER=e2e.manager@sevamrita.local
# E2E_COORDINATOR_USER=e2e.coordinator@sevamrita.local
# E2E_VOLUNTEER_USER=e2e.volunteer@sevamrita.local
